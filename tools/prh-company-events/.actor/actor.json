{
  "actorSpecification": 1,
  "name": "prh-company-events",
  "title": "Finnish Company Events Feed (PRH open data) - company-level",
  "description": "Daily feed of Finnish Trade Register company events (PRH open data): new companies, name changes, liquidations, bankruptcies, restructurings, dissolutions, industry changes, watchlist diffs. New: Norway mode (Brreg, NLOD). Company-level only, attribution included. Not affiliated with PRH/Brreg.",
  "version": "0.2",
  "buildTag": "beta",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Events",
          "transformation": {
            "fields": [
              "eventDate",
              "eventLabel",
              "businessId",
              "companyName",
              "previousName",
              "companyForm",
              "mainBusinessLine",
              "location",
              "attribution"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      },
      "fields": {
        "type": "object",
        "properties": {
          "eventKey": {
            "type": "string",
            "title": "Event key",
            "description": "Deterministic identifier for the company event (eventType|businessId|date)."
          },
          "eventType": {
            "type": "string",
            "title": "Event type code",
            "description": "Event category code (e.g., new_company, name_change, liquidation)."
          },
          "eventLabel": {
            "type": [
              "string",
              "null"
            ],
            "title": "Event type",
            "description": "Human-readable event type."
          },
          "eventDate": {
            "type": "string",
            "title": "Event date",
            "description": "ISO date when the event was registered."
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "title": "Country",
            "description": "Present on Norway-mode records only: 'NO'. Absent on default Finnish records."
          },
          "registry": {
            "type": [
              "string",
              "null"
            ],
            "title": "Registry",
            "description": "Present on Norway-mode records only: 'no_brreg'."
          },
          "businessId": {
            "type": [
              "string",
              "null"
            ],
            "title": "Business ID (Y-tunnus / organisasjonsnummer)",
            "description": "Finnish Business ID (Y-tunnus); in Norway mode the 9-digit organisasjonsnummer."
          },
          "companyName": {
            "type": [
              "string",
              "null"
            ],
            "title": "Company name",
            "description": "Current registered company name."
          },
          "previousName": {
            "type": [
              "string",
              "null"
            ],
            "title": "Previous name",
            "description": "Prior registered name if applicable."
          },
          "companyForm": {
            "type": [
              "object",
              "null"
            ],
            "title": "Company form",
            "description": "Legal form: { code, en, fi } (PRH company form code and labels); Norway mode adds no (Brreg organisasjonsform label) with fi null.",
            "properties": {
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "en": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fi": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "no": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "mainBusinessLine": {
            "type": [
              "object",
              "null"
            ],
            "title": "Main industry (TOL 2008)",
            "description": "Main industry classification: { tol2008, en, fi, since }. Norway mode: tol2008/en/fi null and { naceCode, no } from Brreg naeringskode1 (SN2007/SN2025).",
            "properties": {
              "tol2008": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "en": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fi": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "naceCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "no": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "location": {
            "type": [
              "object",
              "null"
            ],
            "title": "Municipality / domicile",
            "description": "Registered-office municipality only: { postCode, city, municipalityCode }. No street addresses.",
            "properties": {
              "postCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "city": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "municipalityCode": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "attribution": {
            "type": "string",
            "title": "Source attribution",
            "description": "Mandatory CC BY 4.0 PRH source attribution. Norway-mode records carry the Brreg NLOD 2.0 attribution."
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}
